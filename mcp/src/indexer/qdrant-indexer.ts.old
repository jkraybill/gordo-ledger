/**
 * Qdrant Indexer Implementation (Session 33 - TDD approach)
 * Hybrid search (0.7 dense + 0.3 BM25), session-level indexing
 */

import { QdrantClient } from '@qdrant/js-client-rest';
import { SessionEntry, SessionSignals } from '../types.js';

export interface QdrantConfig {
  path: string;
  collectionName: string;
  vectorSize: number;
}

export interface SearchFilters {
  dateRange?: { start: string; end: string };
  signals?: Partial<SessionSignals>;
  hasPatterns?: boolean;
  hasCode?: boolean;
  hasLinks?: boolean;
}

export interface SearchResult {
  id: string;
  content: string;
  score: number;
  metadata: SessionMetadata;
}

export interface SessionMetadata {
  date: string;
  summary?: string;
  patterns?: string[];
  issues?: string[];
  signals: SessionSignals;
  wordCount: number;
  hasCode: boolean;
  hasLinks: boolean;
}

export function createQdrantIndexer(config: QdrantConfig) {
  const client = new QdrantClient({ path: config.path });
  let initialized = false;

  return {
    async initialize(): Promise<void> {
      if (initialized) return;

      try {
        // Check if collection exists
        const collections = await client.getCollections();
        const exists = collections.collections.some(c => c.name === config.collectionName);

        if (!exists) {
          // Create collection with hybrid search support
          await client.createCollection(config.collectionName, {
            vectors: {
              size: config.vectorSize,
              distance: 'Cosine'
            },
            sparse_vectors: {
              text: {} // Enable sparse vectors for BM25
            }
          });
        }

        initialized = true;
      } catch (error) {
        throw new Error(`Failed to initialize Qdrant: ${error instanceof Error ? error.message : String(error)}`);
      }
    },

    async getStatus() {
      const collections = await client.getCollections();
      const collectionExists = collections.collections.some(c => c.name === config.collectionName);

      let documentCount = 0;
      if (collectionExists) {
        const collectionInfo = await client.getCollection(config.collectionName);
        documentCount = collectionInfo.points_count || 0;
      }

      return {
        initialized,
        collectionExists,
        documentCount
      };
    },

    async getCollectionInfo() {
      return await client.getCollection(config.collectionName);
    },

    async addDocument(session: SessionEntry, embedding: number[]): Promise<void> {
      const metadata = extractMetadata(session);
      const sparseVector = generateSparseVector(session.content);

      await client.upsert(config.collectionName, {
        points: [
          {
            id: session.id,
            vector: {
              '': embedding, // Default dense vector
              text: sparseVector // Sparse vector for BM25
            },
            payload: {
              id: session.id,
              content: session.content,
              metadata
            }
          }
        ]
      });
    },

    async addDocuments(sessions: SessionEntry[], embeddings: number[][]): Promise<void> {
      if (sessions.length !== embeddings.length) {
        throw new Error('Sessions and embeddings arrays must have same length');
      }

      const points = sessions.map((session, i) => {
        const metadata = extractMetadata(session);
        const sparseVector = generateSparseVector(session.content);

        return {
          id: session.id,
          vector: {
            '': embeddings[i], // Default dense vector
            text: sparseVector // Sparse vector for BM25
          },
          payload: {
            id: session.id,
            content: session.content,
            metadata
          }
        };
      });

      await client.upsert(config.collectionName, { points });
    },

    async getDocument(id: string): Promise<(SessionEntry & { metadata: SessionMetadata }) | null> {
      try {
        const result = await client.retrieve(config.collectionName, {
          ids: [id],
          with_payload: true
        });

        if (result.length === 0) return null;

        const point = result[0];
        return {
          id: point.payload.id as string,
          content: point.payload.content as string,
          date: point.payload.metadata.date as string,
          summary: point.payload.metadata.summary as string,
          patterns: point.payload.metadata.patterns as string[],
          issues: point.payload.metadata.issues as string[],
          signals: point.payload.metadata.signals as SessionSignals,
          metadata: point.payload.metadata as SessionMetadata
        };
      } catch (error) {
        return null;
      }
    },

    async hybridSearch(
      queryEmbedding: number[],
      queryText: string,
      limit: number,
      threshold?: number,
      filters?: SearchFilters
    ): Promise<SearchResult[]> {
      const querySparseVector = generateSparseVector(queryText);

      // Build filter conditions
      const must: any[] = [];

      if (filters?.dateRange) {
        must.push({
          key: 'metadata.date',
          range: {
            gte: filters.dateRange.start,
            lte: filters.dateRange.end
          }
        });
      }

      if (filters?.signals) {
        for (const [key, value] of Object.entries(filters.signals)) {
          must.push({
            key: `metadata.signals.${key}`,
            match: { value }
          });
        }
      }

      if (filters?.hasPatterns) {
        must.push({
          key: 'metadata.patterns',
          is_empty: false
        });
      }

      if (filters?.hasCode !== undefined) {
        must.push({
          key: 'metadata.hasCode',
          match: { value: filters.hasCode }
        });
      }

      if (filters?.hasLinks !== undefined) {
        must.push({
          key: 'metadata.hasLinks',
          match: { value: filters.hasLinks }
        });
      }

      // Hybrid search: 0.7 dense + 0.3 sparse (BM25)
      const result = await client.search(config.collectionName, {
        vector: {
          name: '', // Default dense vector
          vector: queryEmbedding
        },
        limit,
        score_threshold: threshold,
        filter: must.length > 0 ? { must } : undefined,
        with_payload: true
      });

      // Note: Qdrant doesn't support true hybrid in a single query yet
      // We'll do dense search and boost results that match sparse terms
      const results: SearchResult[] = result.map(point => {
        let score = point.score;

        // Boost score if query text matches content (simple BM25 approximation)
        const content = (point.payload.content as string).toLowerCase();
        const queryTerms = queryText.toLowerCase().split(/\s+/);
        const matchedTerms = queryTerms.filter(term => content.includes(term));
        const sparseBoost = (matchedTerms.length / queryTerms.length) * 0.3;

        score = score * 0.7 + sparseBoost;

        return {
          id: point.payload.id as string,
          content: point.payload.content as string,
          score,
          metadata: point.payload.metadata as SessionMetadata
        };
      });

      // Re-sort by hybrid score
      results.sort((a, b) => b.score - a.score);

      return results.slice(0, limit);
    },

    async deleteDocument(id: string): Promise<void> {
      await client.delete(config.collectionName, {
        points: [id]
      });
    },

    async clear(): Promise<void> {
      // Delete and recreate collection
      try {
        await client.deleteCollection(config.collectionName);
      } catch (e) {
        // Collection might not exist
      }

      await client.createCollection(config.collectionName, {
        vectors: {
          size: config.vectorSize,
          distance: 'Cosine'
        },
        sparse_vectors: {
          text: {}
        }
      });
    },

    async close(): Promise<void> {
      // Qdrant client doesn't need explicit close in embedded mode
      initialized = false;
    }
  };
}

function extractMetadata(session: SessionEntry): SessionMetadata {
  const content = session.content;

  return {
    date: session.date,
    summary: session.summary,
    patterns: session.patterns,
    issues: session.issues,
    signals: session.signals!,
    wordCount: content.split(/\s+/).length,
    hasCode: /```/.test(content), // Detect code blocks
    hasLinks: /https?:\/\//.test(content) // Detect URLs
  };
}

function generateSparseVector(text: string): { indices: number[]; values: number[] } {
  // Simple BM25-style sparse vector
  // In production, this would use proper text processing
  const terms = text.toLowerCase().split(/\s+/);
  const termFreqs = new Map<string, number>();

  for (const term of terms) {
    termFreqs.set(term, (termFreqs.get(term) || 0) + 1);
  }

  // Convert to sparse vector format
  // For simplicity, we'll use term hash as index
  const indices: number[] = [];
  const values: number[] = [];

  for (const [term, freq] of termFreqs.entries()) {
    const hash = simpleHash(term);
    indices.push(hash);
    values.push(freq);
  }

  return { indices, values };
}

function simpleHash(str: string): number {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    hash = ((hash << 5) - hash) + str.charCodeAt(i);
    hash = hash & hash; // Convert to 32bit integer
  }
  return Math.abs(hash) % 100000; // Limit to reasonable range
}
